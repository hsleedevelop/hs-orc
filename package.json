{
  "name": "hs-orchestrator",
  "version": "0.1.0",
  "description": "작업 1건을 분류 → primary·reviewer 두 슬롯 배정 → 하한선 검사 → 실제 CLI 엔진(claude/codex/cursor) 실행 → 증거로 종료하는 로컬 오케스트레이터",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hsleedevelop/hs-orc.git"
  },
  "homepage": "https://github.com/hsleedevelop/hs-orc#readme",
  "bugs": "https://github.com/hsleedevelop/hs-orc/issues",
  "keywords": [
    "ai",
    "agent",
    "orchestrator",
    "cli",
    "claude",
    "codex",
    "cursor",
    "router"
  ],
  "private": true,
  "type": "module",
  "bin": {
    "hs-orc": "./bin/hs-orc.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "gen:matrix": "node scripts/gen-matrix.mjs",
    "type-check": "tsc --noEmit && tsc -p tsconfig.renderer.json",
    "lint": "eslint .",
    "test": "node --test 'src/**/__tests__/*.test.ts'",
    "gate": "npm run matrix:check && npm run type-check && npm run lint && npm run test",
    "secret-scan": "gitleaks protect --staged --redact --no-banner",
    "prepare": "git config core.hooksPath githooks",
    "matrix:check": "node scripts/gen-matrix.mjs --check",
    "tui": "node bin/hs-orc.mjs tui",
    "build:gui": "node bin/hs-orc.mjs build-gui",
    "gui": "node bin/hs-orc.mjs gui"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.4.3",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "dependencies": {
    "ink": "7.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
